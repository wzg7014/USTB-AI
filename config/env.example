# =============================
# USTB AI教务助手 环境变量样例（模板）
# 说明：此文件仅为占位模板，不包含任何敏感信息。
# 使用方式：复制为项目根目录 .env 并根据实际环境填写。
# =============================

# 基础服务
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60000
CORS_ORIGINS=http://localhost:3000

# 安全
SECRET_KEY=please-change-me

# 数据库（MySQL 作为唯一主栈）
# 示例：mysql://user:password@localhost:3306/ustb
DATABASE_URL=mysql://user:password@localhost:3306/ustb

# 下游服务
RAG_API_URL=http://localhost:8000
# 留空表示禁用 Hybrid（默认禁用）
HYBRID_API_URL=

# 缓存与存储（可选）
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
CACHE_TTL=1800

# OpenAI 兼容层
ENABLE_SSE=true
X_REQUEST_ID_HEADER=X-Request-ID

# 其他可选项（按需追加，保持“只增不改”原则）
# RATE_LIMIT_RPS=10
# REQUEST_TIMEOUT_CHAT=60000
# CORS_ORIGINS_EXTRA=

