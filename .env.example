# USTB AI教务助手 - 环境变量配置示例
# 复制此文件为 .env 并填入真实的API密钥

# 阿里云百炼平台API密钥
# 获取方式：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 项目配置
PROJECT_NAME=USTB-AI-Assistant
PROJECT_VERSION=1.0.0
ENVIRONMENT=development

# 数据库配置（如果需要）
DATABASE_URL=sqlite:///data/ustb_assistant.db

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# 成本控制
MAX_API_BUDGET=0.4
COST_ALERT_EMAIL=your_email@example.com

# 性能配置
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30

# 安全配置
API_RATE_LIMIT=100
ENABLE_COST_TRACKING=true
